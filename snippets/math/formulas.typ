// Name: Formulas
#let sec(t) = table.cell(colspan: 2, inset: (top: 4pt, bottom: 1.5pt, x: 2pt),
  text(font: sys.inputs.at("sans", default: "Helvetica Neue"), weight: "bold", size: 6.3pt, tracking: 0.05em, upper(t)))
#table(
  columns: (auto, 1fr), stroke: none, inset: (x: 2pt, y: 1.8pt),
  sec[Sums],
  [Powers], [$sum_(i=1)^n i^2 = n(n+1)(2n+1)\/6$, #h(3pt) $sum_(i=1)^n i^3 = (n(n+1)\/2)^2$],
  [Geometric], [$sum_(i=0)^(n-1) r^i = (r^n - 1)\/(r - 1)$, #h(3pt) $sum_(i>=0) i r^i = r\/(1-r)^2$],
  sec[Counting],
  [Vandermonde], [$sum_k binom(m, k) binom(n, r-k) = binom(m+n, r)$],
  [Hockey stick], [$sum_(i=r)^n binom(i, r) = binom(n+1, r+1)$],
  [Stars, bars], [$x_1 + dots + x_k = n$, $x_i >= 0$: $binom(n+k-1, k-1)$ solutions],
  [Catalan], [$C_n = binom(2n, n)\/(n+1)$, $C_(n+1) = sum_i C_i C_(n-i)$: 1 1 2 5 14 42 132 429 1430],
  [Stirling 1], [cycles: $c(n,k) = c(n-1,k-1) + (n-1) c(n-1,k)$],
  [Stirling 2], [blocks: $S(n,k) = S(n-1,k-1) + k S(n-1,k) = 1/k! sum_i (-1)^i binom(k,i)(k-i)^n$],
  [Bell], [$B_(n+1) = sum_k binom(n, k) B_k$: 1 1 2 5 15 52 203 877 4140],
  [Derangements], [$D_n = (n-1)(D_(n-1) + D_(n-2)) = n! sum_(i=0)^n (-1)^i \/ i!$],
  [Partitions], [$p(n) = sum_(k != 0) (-1)^(k+1) p(n - k(3k-1)\/2)$ over $k = plus.minus 1, plus.minus 2, dots$],
  [Incl.–excl.], [$|union.big A_i| = sum_(S != emptyset) (-1)^(|S|+1) |inter.big_(i in S) A_i|$],
  sec[Number theory],
  [Möbius], [$g(n) = sum_(d|n) f(d) <==> f(n) = sum_(d|n) mu(d) g(n\/d)$, #h(3pt) $sum_(d|n) mu(d) = [n = 1]$],
  [Totient], [$phi(n) = n product_(p|n) (1 - 1\/p)$, #h(3pt) $sum_(d|n) phi(d) = n$],
  [Euler], [$a^e equiv a^(e mod phi(m) + phi(m)) space (mod m)$ for $e >= log_2 m$, any $a$],
  [gcd sums], [$sum_(i=1)^n gcd(i, n) = sum_(d|n) d phi(n\/d)$, #h(3pt) $sum_(i<=n, gcd(i,n)=1) i = n phi(n)\/2$ ($n > 1$)],
  [Lucas], [$binom(n, k) equiv product_i binom(n_i, k_i) space (mod p)$, digits in base $p$],
  [Wilson], [$(p-1)! equiv -1 space (mod p)$],
  [Frobenius], [$gcd(a, b) = 1$: largest non-representable $a x + b y$ ($x, y >= 0$) is $a b - a - b$],
  [Fibonacci], [$F_(m+n) = F_m F_(n+1) + F_(m-1) F_n$, #h(3pt) $gcd(F_m, F_n) = F_(gcd(m,n))$],
  sec[Geometry],
  [Triangle], [$A = a b sin C\/2 = sqrt(s(s-a)(s-b)(s-c))$, $R = a b c\/(4A)$, $r = A\/s$],
  [Laws], [$c^2 = a^2 + b^2 - 2 a b cos C$, #h(3pt) $a\/sin A = 2R$],
  [Solids], [sphere $4/3 pi r^3$, area $4 pi r^2$; cone $pi r^2 h\/3$; cap $pi h^2 (3r - h)\/3$],
  [Sphere dist.], [$r arccos(sin phi_1 sin phi_2 + cos phi_1 cos phi_2 cos(lambda_1 - lambda_2))$],
  [Planar graph], [$V - E + F = 1 + C$ ($C$ components), #h(3pt) $E <= 3V - 6$],
  sec[Probability],
  [Expectation], [$E[X] = sum_(k>=1) P(X >= k)$ for $X in NN$; geometric: $1\/p$ trials],
  [Coupons], [all $n$ coupons: $n H_n approx n ln n$ draws],
)
